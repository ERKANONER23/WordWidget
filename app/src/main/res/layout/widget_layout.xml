<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- ═══════════════════════════════════════════ -->
    <!-- SOL SÜTUN (Dikey LinearLayout)              -->
    <!-- ═══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="6.5"
        android:orientation="vertical">

        <!-- Sol Üst: BÜYÜK Saat -->
        <TextView
            android:id="@+id/widget_clock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="36sp"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeStepGranularity="2sp" />

        <!-- Yatay Kırmızı Çizgi (Sol) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#FF4444" />

        <!-- Sol Alt: Kelimeler (Ortalanmış) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/widget_english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeStepGranularity="1sp" />

            <TextView
                android:id="@+id/widget_turkish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#AAAAAA"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════════ -->
    <!-- DİKEY KIRMIZI ÇİZGİ (Orta)                  -->
    <!-- ═══════════════════════════════════════════ -->
    <TextView
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="#FF4444"
        android:layout_marginHorizontal="8dp" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- SAĞ SÜTUN (Dikey LinearLayout)              -->
    <!-- ═══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3.5"
        android:orientation="vertical">

        <!-- Sağ Üst: Gün İsmi (Ortalanmış) -->
        <TextView
            android:id="@+id/widget_day"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp" />

        <!-- Yatay Kırmızı Çizgi (Sağ) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#FF4444" />

        <!-- Sağ Alt: Gün Numarası + Ay/Yıl (Ortalanmış) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/widget_day_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="24sp"
                android:autoSizeMaxTextSize="48sp"
                android:autoSizeStepGranularity="2sp" />

            <TextView
                android:id="@+id/widget_month_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#AAAAAA"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>